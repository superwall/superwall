{
  "name": "superwall",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "test": "bun run --filter '@superwall/*' test:run",
    "test:coverage": "bun run --filter '@superwall/*' test:coverage",
    "typecheck": "bun run --filter '@superwall/*' typecheck",
    "build": "bun run --filter '@superwall/*' build",
    "clean": "bun run --filter '@superwall/*' clean",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "devDependencies": {
    "oxfmt": "^0.19.0",
    "oxlint": "^1.35.0"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "packageManager": "bun@1.3.14"
}

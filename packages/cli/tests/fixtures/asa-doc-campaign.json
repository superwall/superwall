{
  "metadata": {
    "title": "Campaign"
  },
  "abstract": [
    {
      "text": "The top-level container that defines a campaign\u2019s promoted object, billing, scheduling, and targeting.",
      "type": "text"
    }
  ],
  "primaryContentSections": [
    {
      "declarations": [
        {
          "languages": [
            "data"
          ],
          "platforms": [
            "Unsupported OS: Apple Ads Platform API"
          ],
          "tokens": [
            {
              "kind": "text",
              "text": "object "
            },
            {
              "kind": "identifier",
              "text": "Campaign"
            }
          ]
        }
      ],
      "kind": "declarations"
    },
    {
      "items": [
        {
          "attributes": [],
          "content": [
            {
              "inlineContent": [
                {
                  "text": "The ad account this campaign belongs to. Read-only.",
                  "type": "text"
                }
              ],
              "type": "paragraph"
            }
          ],
          "name": "adAccountId",
          "required": false,
          "type": [
            {
              "kind": "text",
              "text": "int64"
            }
          ]
        },
        {
          "attributes": [],
          "content": [
            {
              "inlineContent": [
                {
                  "text": "Campaign name. Maximum 200 characters. Must be non-empty. Mutable.",
                  "type": "text"
                }
              ],
              "type": "paragraph"
            }
          ],
          "name": "name",
          "required": false,
          "type": [
            {
              "kind": "text",
              "text": "string"
            }
          ]
        },
        {
          "attributes": [],
          "content": [
            {
              "inlineContent": [
                {
                  "text": "The event type that triggers a charge (for example, ",
                  "type": "text"
                },
                {
                  "code": "TAPS",
                  "type": "codeVoice"
                },
                {
                  "text": " or ",
                  "type": "text"
                },
                {
                  "code": "IMPRESSIONS",
                  "type": "codeVoice"
                },
                {
                  "text": "). See ",
                  "type": "text"
                },
                {
                  "identifier": "doc://com.apple.apple-ads-platform-api/documentation/Apple-Ads-Platform-API/BillingEvent",
                  "isActive": true,
                  "type": "reference"
                },
                {
                  "text": ". Read-only.",
                  "type": "text"
                }
              ],
              "type": "paragraph"
            }
          ],
          "name": "billingEvent",
          "required": false,
          "type": [
            {
              "identifier": "doc://com.apple.apple-ads-platform-api/documentation/Apple-Ads-Platform-API/Campaign/BillingEvent-data.typealias",
              "kind": "typeIdentifier",
              "preciseIdentifier": "data:apple-ads-platform-api:Campaign.BillingEvent",
              "text": "Campaign.BillingEvent"
            }
          ]
        },
        {
          "attributes": [],
          "content": [
            {
              "inlineContent": [
                {
                  "text": "The payment model for this campaign (for example, ",
                  "type": "text"
                },
                {
                  "code": "LOC",
                  "type": "codeVoice"
                },
                {
                  "text": " for Line of Credit or ",
                  "type": "text"
                },
                {
                  "code": "PAYG",
                  "type": "codeVoice"
                },
                {
                  "text": " for Pay As You Go). See ",
                  "type": "text"
                },
                {
                  "identifier": "doc://com.apple.apple-ads-platform-api/documentation/Apple-Ads-Platform-API/PaymentModel",
                  "isActive": true,
                  "type": "reference"
                },
                {
                  "text": ". System-set, Read-only.",
                  "type": "text"
                }
              ],
              "type": "paragraph"
            }
          ],
          "name": "paymentModel",
          "required": false,
          "type": [
            {
              "identifier": "doc://com.apple.apple-ads-platform-api/documentation/Apple-Ads-Platform-API/Campaign/PaymentModel-data.typealias",
              "kind": "typeIdentifier",
              "preciseIdentifier": "data:apple-ads-platform-api:Campaign.PaymentModel",
              "text": "Campaign.PaymentModel"
            }
          ]
        },
        {
          "attributes": [],
          "content": [
            {
              "inlineContent": [
                {
                  "text": "The scheduled start date and time of the campaign. Format: ",
                  "type": "text"
                },
                {
                  "code": "yyyy-MM-dd'T'HH:mm:ss.SSS",
                  "type": "codeVoice"
                },
                {
                  "text": " in UTC (for example, ",
                  "type": "text"
                },
                {
                  "code": "2026-06-07T00:00:00.000",
                  "type": "codeVoice"
                },
                {
                  "text": "). Mutable.",
                  "type": "text"
                }
              ],
              "type": "paragraph"
            }
          ],
          "name": "startTime",
          "required": false,
          "type": [
            {
              "kind": "text",
              "text": "date-time"
            }
          ]
        },
        {
          "attributes": [],
          "content": [
            {
              "inlineContent": [
                {
                  "text": "The scheduled end date and time. Format: ",
                  "type": "text"
                },
                {
                  "code": "yyyy-MM-dd'T'HH:mm:ss.SSS",
                  "type": "codeVoice"
                },
                {
                  "text": " in UTC (for example, ",
                  "type": "text"
                },
                {
                  "code": "2026-12-31T00:00:00.000",
                  "type": "codeVoice"
                },
                {
                  "text": "). Omit to keep the campaign running indefinitely. Mutable.",
                  "type": "text"
                }
              ],
              "type": "paragraph"
            }
          ],
          "name": "endTime",
          "required": false,
          "type": [
            {
              "kind": "text",
              "text": "date-time"
            }
          ]
        },
        {
          "attributes": [],
          "content": [
            {
              "inlineContent": [
                {
                  "text": "Whether this campaign promotes an App Store app (",
                  "type": "text"
                },
                {
                  "code": "APPSTORE_APP",
                  "type": "codeVoice"
                },
                {
                  "text": ") or a brand (",
                  "type": "text"
                },
                {
                  "code": "BUSINESS_BRAND",
                  "type": "codeVoice"
                },
                {
                  "text": "). See ",
                  "type": "text"
                },
                {
                  "identifier": "doc://com.apple.apple-ads-platform-api/documentation/Apple-Ads-Platform-API/PromotedObjectType",
                  "isActive": true,
                  "type": "reference"
                },
                {
                  "text": ". Read-only.",
                  "type": "text"
                }
              ],
              "type": "paragraph"
            }
          ],
          "name": "promotedObjectType",
          "required": false,
          "type": [
            {
              "identifier": "doc://com.apple.apple-ads-platform-api/documentation/Apple-Ads-Platform-API/Campaign/PromotedObjectType-data.typealias",
              "kind": "typeIdentifier",
              "preciseIdentifier": "data:apple-ads-platform-api:Campaign.PromotedObjectType",
              "text": "Campaign.PromotedObjectType"
            }
          ]
        },
        {
          "attributes": [],
          "content": [
            {
              "inlineContent": [
                {
                  "text": "The identifier of the promoted entity: the ",
                  "type": "text"
                },
                {
                  "code": "adamId",
                  "type": "codeVoice"
                },
                {
                  "text": " for App Store apps or the brand ID for Brands. Read-only.",
                  "type": "text"
                }
              ],
              "type": "paragraph"
            }
          ],
          "name": "promotedObjectId",
          "required": false,
          "type": [
            {
              "kind": "text",
              "text": "string"
            }
          ]
        },
        {
          "attributes": [],
          "content": [
            {
              "inlineContent": [
                {
                  "text": "Captures the advertiser\u2019s intent for the campaign to serve. See ",
                  "type": "text"
                },
                {
                  "identifier": "doc://com.apple.apple-ads-platform-api/documentation/Apple-Ads-Platform-API/CampaignStatus",
                  "isActive": true,
                  "type": "reference"
                },
                {
                  "text": ". Mutable.",
                  "type": "text"
                }
              ],
              "type": "paragraph"
            }
          ],
          "name": "status",
          "required": false,
          "type": [
            {
              "identifier": "doc://com.apple.apple-ads-platform-api/documentation/Apple-Ads-Platform-API/Campaign/Status-data.typealias",
              "kind": "typeIdentifier",
              "preciseIdentifier": "data:apple-ads-platform-api:Campaign.Status",
              "text": "Campaign.Status"
            }
          ]
        }
      ],
      "kind": "properties",
      "title": "Properties"
    },
    {
      "content": [
        {
          "anchor": "Discussion",
          "level": 2,
          "text": "Discussion",
          "type": "heading"
        },
        {
          "inlineContent": [
            {
              "text": "A ",
              "type": "text"
            },
            {
              "code": "Campaign",
              "type": "codeVoice"
            },
            {
              "text": " is the top-level advertising container that defines the promoted object, billing model, scheduling, and geographic targeting for a set of ad groups. Each campaign belongs to a single ad account and promotes either an App Store app (",
              "type": "text"
            },
            {
              "code": "APPSTORE_APP",
              "type": "codeVoice"
            },
            {
              "text": ") or a brand (",
              "type": "text"
            },
            {
              "code": "BUSINESS_BRAND",
              "type": "codeVoice"
            },
            {
              "text": "). The ",
              "type": "text"
            },
            {
              "code": "billingEvent",
              "type": "codeVoice"
            },
            {
              "text": ", ",
              "type": "text"
            },
            {
              "code": "promotedObjectType",
              "type": "codeVoice"
            },
            {
              "text": ", and ",
              "type": "text"
            },
            {
              "code": "promotedObjectId",
              "type": "codeVoice"
            },
            {
              "text": " fields stay fixed after creation. To change any of them, create a new campaign.",
              "type": "text"
            }
          ],
          "type": "paragraph"
        },
        {
          "inlineContent": [
            {
              "text": "The ",
              "type": "text"
            },
            {
              "code": "status",
              "type": "codeVoice"
            },
            {
              "text": " field captures the advertiser\u2019s intent for the campaign to serve. The ",
              "type": "text"
            },
            {
              "code": "systemStatus",
              "type": "codeVoice"
            },
            {
              "text": " field reflects Apple\u2019s system assessment of whether the campaign can deliver. When ",
              "type": "text"
            },
            {
              "code": "systemStatus",
              "type": "codeVoice"
            },
            {
              "text": " isn\u2019t ",
              "type": "text"
            },
            {
              "code": "RUNNING",
              "type": "codeVoice"
            },
            {
              "text": ", inspect ",
              "type": "text"
            },
            {
              "code": "systemStatusReasons",
              "type": "codeVoice"
            },
            {
              "text": " to identify blocking conditions and ",
              "type": "text"
            },
            {
              "code": "systemStatusLimitingReasons",
              "type": "codeVoice"
            },
            {
              "text": " for delivery-reducing (but non-blocking) factors.",
              "type": "text"
            }
          ],
          "type": "paragraph"
        },
        {
          "inlineContent": [
            {
              "text": "A required ",
              "type": "text"
            },
            {
              "code": "dailyBudget",
              "type": "codeVoice"
            },
            {
              "text": " cap controls the campaign\u2019s budget and limits daily spending. You can also assign a campaign to one or more shared budgets via ",
              "type": "text"
            },
            {
              "code": "sharedBudgets",
              "type": "codeVoice"
            },
            {
              "text": ". The two budget controls function independently: ",
              "type": "text"
            },
            {
              "code": "dailyBudget",
              "type": "codeVoice"
            },
            {
              "text": " enforces a daily cap. Each shared budget enforces a flight-period cap defined by its ",
              "type": "text"
            },
            {
              "code": "startTime",
              "type": "codeVoice"
            },
            {
              "text": " and ",
              "type": "text"
            },
            {
              "code": "endTime",
              "type": "codeVoice"
            },
            {
              "text": ".",
              "type": "text"
            }
          ],
          "type": "paragraph"
        },
        {
          "inlineContent": [
            {
              "text": "Fields you can filter and sort on when querying campaigns are listed in ",
              "type": "text"
            },
            {
              "identifier": "doc://com.apple.apple-ads-platform-api/documentation/Apple-Ads-Platform-API/POST-campaigns-query",
              "isActive": true,
              "type": "reference"
            },
            {
              "text": ". For the complete list of required and optional fields at creation, see ",
              "type": "text"
            },
            {
              "identifier": "doc://com.apple.apple-ads-platform-api/documentation/Apple-Ads-Platform-API/CampaignCreate",
              "isActive": true,
              "type": "reference"
            },
            {
              "text": ". For the fields that you can change after creation, see ",
              "type": "text"
            },
            {
              "identifier": "doc://com.apple.apple-ads-platform-api/documentation/Apple-Ads-Platform-API/CampaignUpdate",
              "isActive": true,
              "type": "reference"
            },
            {
              "text": ".",
              "type": "text"
            }
          ],
          "type": "paragraph"
        },
        {
          "anchor": "Example",
          "level": 3,
          "text": "Example",
          "type": "heading"
        }
      ],
      "kind": "content"
    }
  ],

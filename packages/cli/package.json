{
  "name": "@superwall/cli",
  "version": "2.1.1",
  "description": "The official CLI for managing Superwall from your terminal or coding agent.",
  "keywords": [
    "agent",
    "android",
    "app-store-connect",
    "cli",
    "ios",
    "paywall",
    "subscriptions",
    "superwall"
  ],
  "homepage": "https://github.com/superwall/superwall/tree/main/packages/cli#readme",
  "bugs": {
    "url": "https://github.com/superwall/superwall/issues"
  },
  "license": "MIT",
  "author": "Superwall",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/superwall/superwall.git",
    "directory": "packages/cli"
  },
  "files": [
    "dist",
    "LICENSE",
    "package.json",
    "prompts",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/entry.d.ts",
      "import": "./dist/entry.js"
    },
    "./auth": {
      "types": "./dist/auth.d.ts",
      "import": "./dist/auth.js"
    },
    "./tools": {
      "types": "./dist/tools.d.ts",
      "import": "./dist/tools.js"
    }
  },
  "scripts": {
    "build": "tsdown && tsx scripts/vendor-skills.ts && bun scripts/build-tools.ts",
    "watch": "tsdown --watch",
    "regen:asc": "tsx scripts/regen-asc-index.ts",
    "skills:vendor": "tsx scripts/vendor-skills.ts",
    "test:parity": "for area in main api-and-asc apple-search-ads; do tsx --tsconfig tsconfig.json scripts/mcp-parity.ts scripts/mcp-parity/$area.json /tmp/mcp-parity-$area.json || exit 1; done",
    "skills:ensure": "test -f dist/skills/index.json || tsx scripts/vendor-skills.ts",
    "dev": "bun bin.ts",
    "test": "bun run skills:ensure && tsx --test --import ./tests/setup.ts $(rg --files tests -g '*.test.ts')",
    "link:global": "tsdown && bun link",
    "typecheck": "tsc --noEmit",
    "prepack": "bun run build",
    "prepublishOnly": "bun run typecheck && bun run test",
    "test:run": "tsx --test $(rg --files tests -g '*.test.ts')",
    "test:coverage": "bun run skills:ensure && tsx --test --import ./tests/setup.ts --experimental-test-coverage --test-coverage-lines=98 --test-coverage-branches=94 --test-coverage-functions=96 $(rg --files tests -g '*.test.ts')",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.201",
    "@superwall/studio": "workspace:*",
    "ansi-escapes": "^7.3.0",
    "fast-glob": "^3.3.3",
    "ink": "^5.2.1",
    "ink-spinner": "^5.0.0",
    "picocolors": "^1.1.1",
    "react": "^18.3.1",
    "uqr": "^0.1.3",
    "wrap-ansi": "^9.0.2",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.31",
    "@types/yargs": "^17.0.33",
    "ink-testing-library": "^4.0.0",
    "tsdown": "^0.15.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "bun@1.3.14",
  "publishConfig": {
    "access": "public"
  }
}

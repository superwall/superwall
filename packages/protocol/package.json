  "keywords": [
    "paywall",
    "protocol",
    "sdk",
    "superwall"
  ],
  "homepage": "https://github.com/superwall/superwall/tree/main/packages/protocol#readme",
  "bugs": {
    "url": "https://github.com/superwall/superwall/issues"
  },
  "license": "FSL-1.1-ALv2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/superwall/superwall.git",
    "directory": "packages/protocol"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public"

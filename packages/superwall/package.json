{
  "name": "superwall",
  "version": "1.1.1",
  "description": "Superwall for Agents — build paywalls and web funnels as mini React apps with file-based routing, preview them against real product data, and ship them through Superwall.",
  "keywords": [
    "agents",
    "android",
    "flutter",
    "funnel",
    "ios",
    "paywall",
    "paywalls",
    "react",
    "react-native",
    "subscriptions",
    "superwall",
    "web-funnel"
  ],
  "homepage": "https://github.com/superwall/superwall/tree/main/packages/superwall#readme",
  "bugs": {
    "url": "https://github.com/superwall/superwall/issues"
  },
  "license": "FSL-1.1-ALv2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/superwall/superwall.git",
    "directory": "packages/superwall"
  },
  "bin": {
    "superwall": "./bin/superwall.js",
    "sw": "./bin/superwall.js"
  },
  "files": [
    "bin",
    "src"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./assets": {
      "types": "./src/assets.d.ts"
    },
    "./checkout": "./src/checkout/index.tsx",
    "./config": "./src/config/index.ts",
    "./hooks": "./src/hooks/index.ts",
    "./internal": "./src/internal.ts",
    "./navigation": "./src/navigation/index.tsx",
    "./build": "./src/build/index.ts",
    "./preview": "./src/preview/server.ts",
    "./discover": "./src/discover.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest",
    "test:run": "vitest --run",
    "test:coverage": "vitest --run --coverage",
    "clean": "rm -rf dist coverage"
  },
  "dependencies": {
    "@stripe/react-stripe-js": "^5.4.0",
    "@stripe/stripe-js": "^8.5.2",
    "@superwall/cli": "workspace:*",
    "@superwall/runtime": "workspace:*",
    "@superwall/studio": "workspace:*",
    "@vitejs/plugin-react-swc": "^4.0.0",
    "tsx": "^4.19.0",
    "vite": "^7.0.0",
    "vite-plugin-singlefile": "^2.3.3"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitest/coverage-v8": "^3.2.0",
    "jsdom": "^26.1.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "typescript": "5.8.3",
    "vitest": "^3.2.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  }
}

{
  "name": "@superwall/runtime",
  "version": "1.2.0",
  "description": "Framework-agnostic runtime for headless Superwall paywalls: bridge, session, products, localization, mock host.",
  "keywords": [
    "paywall",
    "runtime",
    "subscriptions",
    "superwall"
  ],
  "homepage": "https://github.com/superwall/superwall/tree/main/packages/runtime#readme",
  "bugs": {
    "url": "https://github.com/superwall/superwall/issues"
  },
  "license": "FSL-1.1-ALv2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/superwall/superwall.git",
    "directory": "packages/runtime"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest",
    "test:run": "vitest --run",
    "test:coverage": "vitest --run --coverage",
    "clean": "rm -rf dist coverage"
  },
  "dependencies": {
    "@superwall/protocol": "workspace:*"
  },
  "devDependencies": {
    "@superwall/host": "workspace:*",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^3.2.0",
    "typescript": "5.8.3",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
